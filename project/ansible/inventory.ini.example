# Скопируйте в inventory.ini и замените IP на свой:
#   cp inventory.ini.example inventory.ini
# IP из Terraform (глава 08):  terraform -chdir=../terraform output -raw public_ip
#
# inventory.ini в .gitignore — реальные IP не попадают в git.

